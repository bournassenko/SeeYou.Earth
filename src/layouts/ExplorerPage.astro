---
import Activity from "@lucide/astro/icons/activity";
import Binoculars from "@lucide/astro/icons/binoculars";
import CirclePlay from "@lucide/astro/icons/circle-play";
import AstrometryReview from "../components/AstrometryReview";
import DemoTour from "../components/DemoTour.astro";
import DifferencePreview from "../components/DifferencePreview.astro";
import "@fontsource-variable/inter";
import "../styles/theme.css";
import ProjectIntro from "../components/ProjectIntro";
import SkyExplorer from "../components/SkyExplorer";

interface Props {
  page?: "explore" | "review" | "demo";
}

const { page = "explore" } = Astro.props;
const demo = page === "demo";
const navigation = [
  { id: "explore", label: "Explore", href: "/", Icon: Binoculars },
  { id: "review", label: "Review", href: "/review/", Icon: Activity },
  { id: "demo", label: "Demo", href: "/demo/", Icon: CirclePlay },
] as const;
const current = navigation.find((entry) => entry.id === page);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="SeeYou.Earth is an open-source astronomical exploration project."
    />
    <script is:inline>
      const colorPreference = window.matchMedia("(prefers-color-scheme: dark)");
      const applyColorPreference = () =>
        document.documentElement.classList.toggle(
          "dark",
          colorPreference.matches,
        );
      applyColorPreference();
      colorPreference.addEventListener("change", applyColorPreference);
    </script>
    <title>{page === "explore" ? "SeeYou.Earth" : `${current?.label} · SeeYou.Earth`}</title>
  </head>
  <body>
    <a class="skip-link" href="#dashboard-content">
      Skip to content
    </a>
    <div class:list={["dashboard", { "dashboard-demo": demo }]}>
      <header class="sidebar">
        <ProjectIntro />
        <nav aria-label="Workspace">
          {navigation.map(({ id, label, href, Icon }) => (
            <a href={href} aria-current={page === id ? "page" : undefined}>
              <Icon aria-hidden="true" /> {label}
            </a>
          ))}
        </nav>
      </header>
      <main id="dashboard-content" tabindex="-1">
        {demo && <DemoTour />}
        {(page === "explore" || demo) && (
          <SkyExplorer client:load demo={demo} />
        )}
        {demo && <DifferencePreview />}
        {(page === "review" || demo) && (
          <AstrometryReview client:load demo={demo} />
        )}
      </main>
    </div>
  </body>
</html>

<style is:global>
  html {
    background: var(--background);
    color: var(--foreground);
    font-family: "Inter Variable", system-ui, sans-serif;
  }

  body {
    margin: 0;
  }

  .dashboard {
    --workspace-gap: clamp(0.75rem, 1.6vw, 1.5rem);
    --control-height: 2.5rem;
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    min-height: 100vh;
  }

  .dashboard main {
    overflow-anchor: none;
    box-sizing: border-box;
    width: min(100%, 94rem);
    margin-inline: auto;
    padding: clamp(1rem, 2vw, 2rem);
  }

  .skip-link {
    position: fixed;
    z-index: 10;
    inset: 0.5rem auto auto 0.5rem;
    padding: 0.6rem 1rem;
    border-radius: var(--luma-radius-inset);
    background: var(--card);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  h1,
  h2,
  h3 {
    margin: 0;
  }

  h1 {
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    line-height: 1;
    letter-spacing: -0.045em;
    overflow-wrap: anywhere;
  }

  p {
    color: var(--muted-foreground);
    line-height: 1.6;
  }

  .sidebar {
    position: sticky;
    top: 0;
    align-self: start;
    box-sizing: border-box;
    min-height: 100dvh;
    padding: 1.5rem 1rem;
    border-inline-end: 1px solid var(--sidebar-border);
    background: var(--sidebar);
    color: var(--sidebar-foreground);
  }

  .sidebar h1 {
    padding-inline: 0.65rem;
    font-size: 1.25rem;
  }

  .sidebar nav {
    display: grid;
    gap: 0.25rem;
    margin-top: 1.75rem;
  }

  .sidebar nav a {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding-inline: 0.75rem;
    border-radius: var(--luma-radius-surface);
    color: var(--muted-foreground);
    font-size: 0.875rem;
    font-weight: 550;
    text-decoration: none;
  }

  .sidebar nav a:hover {
    background: var(--sidebar-accent);
    color: var(--sidebar-accent-foreground);
  }

  .sidebar nav a[aria-current="page"] {
    background: var(--sidebar-accent);
    color: var(--sidebar-accent-foreground);
    box-shadow: var(--luma-elevation);
  }

  h2 {
    font-size: 1.25rem;
    letter-spacing: -0.025em;
  }

  .explorer {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--workspace-gap);
    max-width: 72rem;
    margin-inline: auto;
  }

  .explorer-controls,
  .viewer,
  .difference-preview,
  .astrometry-review {
    padding: var(--luma-panel-padding);
    border-radius: var(--luma-radius-surface);
    background: var(--card);
    color: var(--card-foreground);
    box-shadow: var(--luma-elevation);
  }

  .archive-date-filter {
    grid-column: 1 / -1;
    font-size: 0.875rem;
  }

  .archive-date-filter summary {
    width: fit-content;
    cursor: pointer;
  }

  .archive-date-filter > div {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: 0.75rem;
    max-width: 26rem;
    margin-top: 0.5rem;
  }

  .archive-coverage-note {
    display: block;
    margin-top: 0.35rem;
  }

  .example-fields {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }

  .example-fields .select-field {
    min-width: min(100%, 11rem);
  }

  .field-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-inline-start: auto;
  }

  .example-fields button,
  .archive-retry {
    background: var(--secondary);
    color: var(--secondary-foreground);
  }

  .archive-series-count,
  .archive-viewer small {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .archive-frame img {
    width: 100%;
    background: var(--secondary);
  }

  .archive-image {
    position: relative;
    isolation: isolate;
  }

  .archive-pin {
    display: grid;
    gap: 0.15rem;
    padding: 0.65rem 0.75rem;
    border-radius: var(--luma-radius-inset);
    background: var(--secondary);
    color: var(--secondary-foreground);
    font-size: 0.875rem;
  }

  .archive-pin > div,
  .archive-source-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .archive-pin > div {
    justify-content: space-between;
  }

  .archive-pin button {
    min-height: 1.75rem;
    padding: 0.2rem 0.4rem;
    background: var(--card);
    color: var(--foreground);
  }

  .archive-source-actions {
    margin-top: 0.75rem;
  }

  .archive-source-actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
  }

  .archive-source-actions a svg {
    width: 1rem;
    height: 1rem;
  }

  .archive-frame figcaption {
    margin-top: 0.5rem;
  }

  .archive-state p {
    margin: 0;
  }

  .archive-retry {
    justify-self: start;
    margin-top: 0.5rem;
  }

  .explorer-controls {
    padding-block: clamp(0.75rem, 1.25vw, 1rem);
  }

  form,
  .coordinate-field {
    display: grid;
    gap: 0.5rem;
  }

  form {
    gap: 1rem;
  }

  label {
    font-weight: 600;
  }

  input:not([type="range"]),
  select,
  button {
    box-sizing: border-box;
    min-width: 0;
    min-height: var(--control-height);
    padding: 0.6rem 0.75rem;
    border: 1px solid transparent;
    font: inherit;
  }

  input,
  select,
  textarea {
    width: 100%;
    color: inherit;
  }

  input:not([type="range"]),
  select,
  textarea {
    border-radius: var(--luma-radius-field);
    background: var(--luma-field);
  }

  input[type="file"]::file-selector-button {
    margin-inline-end: 0.5rem;
    padding: 0.3rem 0.65rem;
    border: 0;
    border-radius: var(--luma-radius-surface);
    background: var(--secondary);
    color: var(--secondary-foreground);
    font: inherit;
    cursor: pointer;
  }

  button {
    border-radius: var(--luma-radius-surface);
    background: var(--primary);
    color: var(--primary-foreground);
    border-color: transparent;
    font-weight: 550;
  }

  button:hover:not(:disabled) {
    filter: brightness(0.9);
    cursor: pointer;
  }

  button:disabled {
    opacity: 0.55;
  }

  :is(button, .evidence-export a, .astrometry-results a) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
  }

  :is(button, .sidebar nav a, .evidence-export a, .astrometry-results a) svg {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  :is(input, select, textarea, button, a, summary, figure img):focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--ring) 30%, transparent);
  }

  .term-label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .term-help {
    position: relative;
    display: inline-flex;
    vertical-align: middle;
  }

  .term-help .term-help-trigger {
    width: 1.5rem;
    min-height: 1.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--muted-foreground);
  }

  .term-help .term-help-trigger:hover,
  .term-help .term-help-trigger:focus-visible {
    background: var(--accent);
    color: var(--accent-foreground);
  }

  .term-help .term-help-trigger svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .term-help-tooltip {
    position: absolute;
    z-index: 5;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    box-sizing: border-box;
    width: min(13rem, 65vw);
    padding: 0.5rem 0.65rem;
    border-radius: var(--luma-radius-inset);
    background: var(--popover);
    color: var(--popover-foreground);
    box-shadow: var(--luma-elevation);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.45;
    text-align: start;
  }

  input[aria-invalid="true"] {
    border-color: var(--destructive);
  }

  .coordinate-field small,
  .field-error {
    font-size: 0.875rem;
  }

  .coordinate-field small,
  dt {
    color: var(--muted-foreground);
  }

  .field-error {
    color: var(--destructive);
  }

  figure {
    margin: 1rem 0 0;
  }

  figure img {
    display: block;
    width: min(100%, 28rem);
    height: auto;
    margin: 0 auto;
    border-radius: var(--luma-radius-inset);
    image-rendering: pixelated;
  }

  .viewer-header,
  .viewer-tools,
  .comparison-labels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .viewer-tools button,
  .source-row-button {
    min-height: 2.25rem;
    background: var(--secondary);
    color: var(--secondary-foreground);
    font-size: 0.875rem;
  }

  .viewer-tools button[aria-pressed="true"],
  .source-row-button[aria-pressed="true"] {
    background: var(--primary);
    color: var(--primary-foreground);
  }

  .sky-window {
    width: min(100%, 28rem);
    aspect-ratio: 1;
    margin-inline: auto;
    overflow: auto;
    border-radius: var(--luma-radius-inset);
    background: var(--background);
  }

  .sky-image {
    position: relative;
    isolation: isolate;
  }

  .sky-image img {
    width: 100%;
    border-radius: 0;
  }

  .sky-image img[tabindex] {
    cursor: crosshair;
  }

  .image-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    margin-top: 0.75rem;
  }

  .image-controls button {
    min-width: 2.5rem;
    min-height: 2.5rem;
    background: var(--secondary);
    color: var(--secondary-foreground);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .image-controls button[aria-pressed="true"] {
    background: var(--primary);
    color: var(--primary-foreground);
  }

  .pixel-reticle {
    position: absolute;
    z-index: 1;
    width: 1rem;
    height: 1rem;
    border: 1px solid var(--foreground);
    box-shadow: 0 0 0 1px var(--background);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .pixel-reticle-pinned {
    width: 1.375rem;
    height: 1.375rem;
    border-width: 2px;
  }

  .comparison-image {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .comparison-divider {
    position: absolute;
    z-index: 3;
    inset-block: 0;
    display: grid;
    width: 2px;
    place-items: center;
    transform: translateX(-50%);
    background: var(--primary);
    box-shadow: 0 0 0 1px var(--background);
    pointer-events: none;
  }

  .comparison-divider > span {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    justify-self: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--card);
    color: var(--card-foreground);
    box-shadow: var(--luma-elevation);
  }

  .comparison-divider svg {
    width: 1rem;
    height: 1rem;
  }

  input.comparison-drag {
    position: absolute;
    z-index: 4;
    top: calc(50% - 1.25rem);
    left: -1rem;
    width: calc(100% + 2rem);
    height: 2.5rem;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
    appearance: none;
  }

  .comparison-drag::-webkit-slider-thumb {
    width: 2rem;
    height: 2rem;
    appearance: none;
  }

  .comparison-drag::-moz-range-thumb {
    width: 2rem;
    height: 2rem;
    border: 0;
  }

  .comparison-divider:has(+ .comparison-drag:focus-visible) > span {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .swipe-control {
    display: grid;
    width: min(100%, 28rem);
    gap: 0.35rem;
    margin: 0.75rem auto 0;
    font-size: 0.875rem;
  }

  .swipe-control small {
    color: var(--muted-foreground);
    font-size: inherit;
  }

  .source-marker {
    position: absolute;
    display: grid;
    width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    place-items: center;
    transform: translate(-50%, -50%);
    background: transparent;
  }

  .source-marker span {
    display: grid;
    position: relative;
    width: 1.375rem;
    height: 1.375rem;
    place-items: center;
    border: 1px solid var(--foreground);
    border-radius: 50%;
    background: var(--background);
    color: var(--foreground);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
  }

  .source-marker[aria-pressed="true"] span {
    border-width: 2px;
    background: var(--primary);
    color: var(--primary-foreground);
  }

  #pixel-position {
    min-block-size: 1.6em;
  }

  .pixel-spectrum {
    margin-block: 1rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--luma-radius-inset);
  }

  .pixel-spectrum h4 {
    margin: 0 0 0.75rem;
  }

  .spectrum-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    align-items: center;
    gap: 1rem;
    font-size: 0.875rem;
  }

  .spectrum-figure {
    color: var(--muted-foreground);
  }

  .spectrum-chart {
    display: grid;
    grid-template-columns: 4ch minmax(0, 1fr);
    gap: 0.75rem;
    margin-block: 0.375rem;
  }

  .spectrum-ticks {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .spectrum-plot {
    position: relative;
    height: 7rem;
    border: 1px solid var(--border);
    border-radius: var(--luma-radius-inset);
    background: var(--background);
  }

  .spectrum-sample {
    position: absolute;
    height: 100%;
    width: 0;
    transform: translateY(-50%);
  }

  .spectrum-uncertainty {
    position: absolute;
    top: 50%;
    left: 0;
    width: 1px;
    transform: translate(-50%, -50%);
    background: var(--muted-foreground);
    pointer-events: none;
  }

  .spectrum-sample button {
    position: absolute;
    top: 50%;
    left: 0;
    width: 1.75rem;
    min-height: 1.75rem;
    padding: 0;
    display: grid;
    place-items: center;
    transform: translate(-50%, -50%);
    background: transparent;
  }

  .spectrum-sample button::after {
    width: 0.625rem;
    height: 0.625rem;
    border: 1px solid var(--foreground);
    border-radius: 50%;
    background: var(--card);
    content: "";
  }

  .spectrum-sample button[aria-pressed="true"]::after {
    background: var(--primary);
  }

  .spectrum-axis {
    margin-inline-start: calc(4ch + 0.75rem);
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .pixel-spectrum small {
    display: block;
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .spectrum-values {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-variant-numeric: tabular-nums;
  }

  .spectrum-values li {
    display: grid;
    padding: 0.35rem 0.55rem;
    gap: 0.15rem;
    border-radius: var(--luma-radius-inset);
    color: var(--muted-foreground);
  }

  .spectrum-values .spectrum-active {
    background: var(--accent);
    color: var(--accent-foreground);
  }

  .dashboard-demo :is(.difference-preview, .astrometry-review) {
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }

  .review-form {
    gap: var(--workspace-gap);
    align-items: start;
  }

  .review-options,
  .review-actions {
    display: grid;
    min-width: 0;
    gap: 0.5rem;
  }

  .review-options {
    gap: 1rem;
  }

  .review-actions {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
  }

  .review-options .field-error {
    margin: 0;
  }

  @media (min-width: 58rem) {
    .review-form {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }

    .review-options {
      padding-inline-start: var(--workspace-gap);
      border-inline-start: 1px solid var(--border);
    }
  }

  .astrometry-review textarea {
    box-sizing: border-box;
    width: 100%;
    padding: 0.75rem;
    border: 1px solid transparent;
    border-radius: var(--luma-radius-inset);
    font-family: ui-monospace, monospace;
    resize: vertical;
  }

  .astrometry-review small,
  .astrometry-metrics span {
    color: var(--muted-foreground);
  }

  .astrometry-review .archived-track {
    background: var(--secondary);
    color: var(--secondary-foreground);
  }

  .astrometry-results {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .astrometry-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: 0.75rem;
  }

  .astrometry-metrics > div {
    display: grid;
    gap: 0.35rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--luma-radius-inset);
  }

  .astrometry-metrics strong,
  .astrometry-results table {
    font-variant-numeric: tabular-nums;
  }

  .astrometry-results :is(th, td) {
    padding: 0.4rem 0.65rem;
    text-align: left;
  }

  .source-inspection {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-block: 1rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--luma-radius-inset);
    font-size: 0.875rem;
  }

  .source-selected {
    background: var(--accent);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .timeline {
    display: grid;
    gap: 0.5rem;
  }

  .select-field {
    min-width: 0;
  }

  .select-field .select-trigger {
    display: flex;
    justify-content: space-between;
    width: 100%;
    border-radius: var(--luma-radius-field);
    background: var(--luma-field);
    color: var(--foreground);
    text-align: start;
    font-size: 0.875rem;
    font-weight: 450;
    font-variant-numeric: tabular-nums;
  }

  .select-trigger [data-placeholder-shown] {
    color: var(--muted-foreground);
  }

  .select-trigger svg {
    display: block;
    color: var(--muted-foreground);
  }

  .select-menu {
    z-index: 20;
