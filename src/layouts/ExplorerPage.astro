---
import Activity from "@lucide/astro/icons/activity";
import Binoculars from "@lucide/astro/icons/binoculars";
import CirclePlay from "@lucide/astro/icons/circle-play";
import Crosshair from "@lucide/astro/icons/crosshair";
import Split from "@lucide/astro/icons/split";
import AstrometryReview from "../components/AstrometryReview";
import DemoTour from "../components/DemoTour.astro";
import DifferencePreview from "../components/DifferencePreview.astro";
import "@fontsource-variable/inter";
import "../styles/theme.css";
import ProjectIntro from "../components/ProjectIntro";
import SkyExplorer from "../components/SkyExplorer";

const { demo = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="SeeYou.Earth is an open-source astronomical exploration project."
    />
    <title>{demo ? "SeeYou.Earth · Demo" : "SeeYou.Earth"}</title>
  </head>
  <body>
    <main>
      <header class="intro">
        <ProjectIntro />
        <nav aria-label="Analysis">
          <a href="#explorer-title">
            <Binoculars aria-hidden="true" /> Explore
          </a>
          <a href="#detected-sources">
            <Crosshair aria-hidden="true" /> Sources
          </a>
          <a href="#difference-title">
            <Split aria-hidden="true" /> Compare
          </a>
          <a href="#astrometry-title">
            <Activity aria-hidden="true" /> Review
          </a>
          <a href={demo ? "/" : "/demo"}>
            <CirclePlay aria-hidden="true" /> {demo ? "Exit demo" : "Demo"}
          </a>
        </nav>
      </header>
      {demo && <DemoTour />}
      <SkyExplorer client:load demo={demo} />
      <DifferencePreview />
      {demo ? (
        <AstrometryReview client:load demo />
      ) : (
        <AstrometryReview client:visible />
      )}
    </main>
  </body>
</html>

<style is:global>
  html {
    color-scheme: dark;
    background: var(--background);
    color: var(--foreground);
    font-family: "Inter Variable", system-ui, sans-serif;
  }

  body {
    margin: 0;
  }

  main {
    box-sizing: border-box;
    width: min(100%, 76rem);
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2.5rem) clamp(1rem, 5vw, 4rem);
  }

  h1,
  h2,
  h3 {
    margin: 0;
  }

  h1 {
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    line-height: 1;
    letter-spacing: -0.045em;
    overflow-wrap: anywhere;
  }

  p {
    color: var(--muted-foreground);
    line-height: 1.6;
  }

  .intro {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .intro nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .intro nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding-inline: 0.75rem;
    color: var(--muted-foreground);
    border-radius: calc(var(--radius) - 2px);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .intro nav a:hover {
    color: var(--accent-foreground);
    background: var(--accent);
  }

  h2 {
    font-size: 1.25rem;
    letter-spacing: -0.025em;
  }

  .explorer {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    gap: 1rem;
  }

  .explorer-controls,
  .viewer {
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .explorer-controls {
    background: var(--card);
  }

  .explorer-controls h2 {
    margin-bottom: 1.25rem;
  }

  form,
  .coordinate-field {
    display: grid;
    gap: 0.5rem;
  }

  form {
    gap: 1rem;
  }

  label {
    font-weight: 600;
  }

  input,
  select,
  button {
    box-sizing: border-box;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--input);
    border-radius: calc(var(--radius) - 2px);
    font: inherit;
  }

  input,
  select {
    width: 100%;
    background: var(--background);
    color: inherit;
  }

  button {
    background: var(--primary);
    color: var(--primary-foreground);
    border-color: transparent;
    font-weight: 550;
  }

  .playback button {
    background: var(--secondary);
    color: var(--secondary-foreground);
  }

  button:hover:not(:disabled) {
    filter: brightness(0.9);
    cursor: pointer;
  }

  button:disabled {
    opacity: 0.55;
  }

  :is(button, .intro nav a, .evidence-export a, .astrometry-results a) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
  }

  :is(button, .intro nav a, .evidence-export a, .astrometry-results a) svg {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  :is(input, select, button, a, summary, figure img):focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  input[aria-invalid="true"] {
    border-color: var(--destructive);
  }

  .coordinate-field small,
  .field-error {
    font-size: 0.875rem;
  }

  .coordinate-field small,
  dt {
    color: var(--muted-foreground);
  }

  .field-error {
    color: var(--destructive);
  }

  .viewer {
    min-height: 16rem;
    background: var(--card);
  }

  figure {
    margin: 1rem 0 0;
  }

  figure img {
    display: block;
    width: min(100%, 28rem);
    height: auto;
    margin: 0 auto;
    border-radius: calc(var(--radius) - 2px);
    image-rendering: pixelated;
  }

  .viewer-header,
  .viewer-tools,
  .comparison-labels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .viewer-tools button,
  .source-row-button {
    min-height: 2.25rem;
    background: var(--secondary);
    color: var(--secondary-foreground);
    font-size: 0.875rem;
  }

  .viewer-tools button[aria-pressed="true"],
  .source-row-button[aria-pressed="true"] {
    background: var(--primary);
    color: var(--primary-foreground);
  }

  .sky-window {
    width: min(100%, 28rem);
    aspect-ratio: 1;
    margin-inline: auto;
    overflow: auto;
    border-radius: calc(var(--radius) - 2px);
    background: var(--background);
  }

  .sky-image {
    position: relative;
    isolation: isolate;
  }

  .sky-image img {
    width: 100%;
    border-radius: 0;
  }

  .sky-image img[tabindex] {
    cursor: crosshair;
  }

  .image-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    margin-top: 0.75rem;
  }

  .image-controls button {
    min-width: 2.5rem;
    min-height: 2.5rem;
    background: var(--secondary);
    color: var(--secondary-foreground);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .image-controls button[aria-pressed="true"] {
    background: var(--primary);
    color: var(--primary-foreground);
  }

  .pixel-reticle {
    position: absolute;
    z-index: 1;
    width: 1rem;
    height: 1rem;
    border: 1px solid var(--foreground);
    box-shadow: 0 0 0 1px var(--background);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .pixel-reticle-pinned {
    width: 1.375rem;
    height: 1.375rem;
    border-width: 2px;
  }

  .comparison-image {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .comparison-divider {
    position: absolute;
    inset-block: 0;
    width: 2px;
    transform: translateX(-50%);
    background: var(--primary);
    box-shadow: 0 0 0 1px var(--background);
    pointer-events: none;
  }

  .swipe-control {
    display: grid;
    width: min(100%, 28rem);
    gap: 0.35rem;
    margin: 0.75rem auto 0;
    font-size: 0.875rem;
  }

  .swipe-control input {
    min-height: 2rem;
    margin: 0;
    padding: 0;
    accent-color: var(--primary);
  }

  .swipe-control small {
    color: var(--muted-foreground);
    font-size: inherit;
  }

  .source-marker {
    position: absolute;
    display: grid;
    width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    place-items: center;
    transform: translate(-50%, -50%);
    background: transparent;
  }

  .source-marker span {
    display: grid;
    position: relative;
    width: 1.375rem;
    height: 1.375rem;
    place-items: center;
    border: 1px solid var(--foreground);
    border-radius: 50%;
    background: var(--background);
    color: var(--foreground);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
  }

  .source-marker[aria-pressed="true"] span {
    border-width: 2px;
    background: var(--primary);
    color: var(--primary-foreground);
  }

  .pixel-spectrum {
    margin-block: 1rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .pixel-spectrum h4 {
    margin: 0 0 0.75rem;
  }

  .spectrum-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    align-items: center;
    gap: 1rem;
    font-size: 0.875rem;
  }

  .spectrum-figure {
    color: var(--muted-foreground);
  }

  .spectrum-chart {
    display: grid;
    grid-template-columns: 4ch minmax(0, 1fr);
    gap: 0.75rem;
    margin-block: 0.375rem;
  }

  .spectrum-ticks {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .spectrum-plot {
    position: relative;
    height: 7rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) - 2px);
    background: var(--background);
  }

  .spectrum-sample {
    position: absolute;
    height: 100%;
    width: 0;
    transform: translateY(-50%);
  }

  .spectrum-uncertainty {
    position: absolute;
    top: 50%;
    left: 0;
    width: 1px;
    transform: translate(-50%, -50%);
    background: var(--muted-foreground);
    pointer-events: none;
  }

  .spectrum-sample button {
    position: absolute;
    top: 50%;
    left: 0;
    width: 1.75rem;
    min-height: 1.75rem;
    padding: 0;
    display: grid;
    place-items: center;
    transform: translate(-50%, -50%);
    background: transparent;
  }

  .spectrum-sample button::after {
    width: 0.625rem;
    height: 0.625rem;
    border: 1px solid var(--foreground);
    border-radius: 50%;
    background: var(--card);
    content: "";
  }

  .spectrum-sample button[aria-pressed="true"]::after {
    background: var(--primary);
  }

  .spectrum-axis {
    margin-inline-start: calc(4ch + 0.75rem);
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .pixel-spectrum small {
    display: block;
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .spectrum-values {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-variant-numeric: tabular-nums;
  }

  .spectrum-values li {
    display: grid;
    padding: 0.35rem 0.55rem;
    gap: 0.15rem;
    border-radius: calc(var(--radius) - 2px);
    color: var(--muted-foreground);
  }

  .spectrum-values .spectrum-active {
    background: var(--accent);
    color: var(--accent-foreground);
  }

  .astrometry-review {
    margin-top: 1rem;
    padding: clamp(1rem, 3vw, 1.5rem);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .astrometry-review form {
    max-width: 38rem;
  }

  .astrometry-review textarea {
    box-sizing: border-box;
    width: 100%;
    padding: 0.75rem;
    background: var(--background);
    border: 1px solid var(--input);
    border-radius: calc(var(--radius) - 2px);
    color: inherit;
    font-family: ui-monospace, monospace;
    resize: vertical;
  }

  .astrometry-review textarea:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .astrometry-review small,
  .astrometry-metrics span {
    color: var(--muted-foreground);
  }

  .astrometry-review form button {
    justify-self: start;
  }

  .astrometry-review .archived-track {
    background: var(--secondary);
    color: var(--secondary-foreground);
  }

  .astrometry-results {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .astrometry-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: 0.75rem;
  }

  .astrometry-metrics > div {
    display: grid;
    gap: 0.35rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .astrometry-metrics strong,
  .astrometry-results table {
    font-variant-numeric: tabular-nums;
  }

  .astrometry-results :is(th, td) {
    padding: 0.4rem 0.65rem;
    text-align: left;
  }

  .source-inspection {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-block: 1rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.875rem;
  }

  .source-selected {
    background: var(--accent);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .timeline {
    display: grid;
    gap: 0.5rem;
  }

  .playback {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  figcaption a {
    color: inherit;
  }

  .archive-results,
  .detections {
    margin-top: 1rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .table-scroll {
    overflow-x: auto;
  }

  .detections ul {
    margin: 0;
    padding-left: 1rem;
  }

  .detections table {
    width: 100%;
    margin-top: 0.75rem;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .detections :is(th, td, caption) {
    padding: 0.375rem;
    text-align: left;
  }

  .archive-results ul {
    padding-left: 1rem;
    overflow-wrap: anywhere;
    font-size: 0.875rem;
  }

  .archive-results li + li {
    margin-top: 0.5rem;
  }

  a {
    color: var(--foreground);
    text-underline-offset: 0.2em;
  }

  .evidence-export {
    margin: 0.75rem 0 0;
  }

  @media (max-width: 44rem) {
    .explorer {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
