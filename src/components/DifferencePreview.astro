---
import TermHelp from "./TermHelp";
import comparison from "../ztfDifference.json";
import tracksJson from "../ztfTracks.json";

const tracks: {
  detectionsPerExposure: number[];
  candidates: {
    ra: number;
    dec: number;
    speedArcsecPerDay: number;
    deltaChiSquared: number;
  }[];
} = tracksJson;

function dateLabel(date: string) {
  return new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${date}Z`));
}
---

<section class="difference-preview" aria-labelledby="difference-title">
  <h2 id="difference-title" class="term-label">
    Image difference{" "}
    <TermHelp client:load term="image difference">
      After aligning two exposures, subtract the earlier image from the later
      one. Light pixels brightened and dark pixels faded.
    </TermHelp>
  </h2>
  <div class="difference-grid">
    <figure>
      <img
        src="/observations/ztf-r-earlier.png"
        width="50"
        height="50"
        alt="Earlier ZTF r-band exposure aligned to the later exposure"
      />
      <figcaption>
        <strong>Earlier</strong>
        <time datetime={`${comparison.dates[0]}Z`}>
          {dateLabel(comparison.dates[0])}
        </time>
      </figcaption>
    </figure>
    <figure>
      <img
        src="/observations/ztf-r-later.png"
        width="50"
        height="50"
        alt="Later ZTF r-band exposure with the same brightness scale"
      />
      <figcaption>
        <strong>Later</strong>
        <time datetime={`${comparison.dates[1]}Z`}>
          {dateLabel(comparison.dates[1])}
        </time>
      </figcaption>
    </figure>
    <figure>
      <img
        src="/observations/ztf-r-difference.png"
        width="50"
        height="50"
        alt="Residual image. Light pixels are brighter in the later exposure, and dark pixels are fainter."
      />
      <figcaption>
        <strong>Difference</strong>
        <span>Later − earlier</span>
      </figcaption>
    </figure>
  </div>
  <div class="difference-footer">
    <p>
      <a href="https://irsa.ipac.caltech.edu/Missions/ztf.html">ZTF · r band</a>
      <span>{comparison.validPixels} shared pixels · Experimental</span>
    </p>
    <details>
      <summary>
        ZTF motion screening · {tracks.candidates.length} candidates
      </summary>
      <p class="term-label">
        Track screening{" "}
        <TermHelp client:load term="motion candidates">
          Detections in different exposures that could follow a common path.
          Image artifacts and unrelated sources can also form apparent tracks.
        </TermHelp>
      </p>
      {tracks.candidates.length === 0 ? (
        <p>
          {tracks.detectionsPerExposure.includes(0)
            ? "At least one exposure has no detections for a three-epoch fit."
            : "No trajectory passed screening across the three ZTF exposures."}
        </p>
      ) : (
        <ol>
          {tracks.candidates.map((candidate) => (
            <li>
              RA {candidate.ra.toFixed(5)}° · Dec {candidate.dec.toFixed(5)}° ·
              {candidate.speedArcsecPerDay.toFixed(2)}″/day · Δχ²{" "}
              {candidate.deltaChiSquared.toFixed(1)}
            </li>
          ))}
        </ol>
      )}
    </details>
  </div>
</section>

<style>
  .difference-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--workspace-gap);
    margin-top: var(--workspace-gap);
  }

  .difference-grid figure {
    margin: 0;
  }

  .difference-grid img {
    width: 100%;
    background: var(--background);
  }

  .difference-grid figcaption {
    display: grid;
    grid-template-rows: auto 1fr;
    align-items: start;
    gap: 0.25rem;
    line-height: 1.3;
  }

  .difference-footer {
    display: grid;
    gap: 0.75rem;
    margin-top: var(--workspace-gap);
    padding-top: var(--workspace-gap);
    border-top: 1px solid var(--border);
  }

  .difference-footer > p {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0;
    font-size: 0.875rem;
  }

  .difference-grid strong {
    color: var(--foreground);
  }
</style>
