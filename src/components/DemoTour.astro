---
import Check from "@lucide/astro/icons/check";
import Circle from "@lucide/astro/icons/circle";

const chapters = [
  { action: "field", title: "Open a deep field" },
  { action: "band", title: "Choose a spectral band" },
  { action: "source", title: "Inspect a source" },
  { action: "playback", title: "Play the observations" },
  { action: "compare", title: "Compare two dates" },
  { action: "report", title: "Find the frame report" },
];
---

<section id="demo-tour" class="demo-checklist" aria-label="Demo steps">
  <ol>
    {chapters.map(({ action, title }) => (
      <li data-demo-step={action}>
        <Circle class="step-pending" aria-hidden="true" />
        <Check class="step-done" aria-hidden="true" />
        <span>{title}</span>
        <span class="demo-status" data-step-result hidden>
          Completed
        </span>
      </li>
    ))}
  </ol>
  <span class="demo-status" role="status" aria-atomic="true">
    Preparing the demo
  </span>
</section>

<div class="demo-ripple" aria-hidden="true">
  <span></span>
  <span></span>
  <span></span>
</div>
<div class="demo-spotlight" aria-hidden="true" hidden></div>
<div class="demo-pointer" aria-hidden="true" hidden>
  <span>
    <svg viewBox="0 0 32 40" aria-hidden="true" focusable="false">
      <path
        d="M3 2.5v30.2l7.6-7.1 5 11.5 5.2-2.3-5-11.3H27L3 2.5Z"
        fill="#090909"
        stroke="#fff"
        stroke-width="2.3"
        stroke-linejoin="round"
      />
    </svg>
  </span>
</div>

<script>
  const tour = document.querySelector<HTMLElement>("#demo-tour");

  if (tour) {
    const steps = [...tour.querySelectorAll<HTMLElement>("[data-demo-step]")];
    const status = tour.querySelector<HTMLElement>("[role=status]")!;
    const spotlight = document.querySelector<HTMLElement>(".demo-spotlight")!;
    const pointer = document.querySelector<HTMLElement>(".demo-pointer")!;
    const ripple = document.querySelector<HTMLElement>(".demo-ripple")!;
    const waves = [...ripple.querySelectorAll("span")];
    document.body.append(spotlight, pointer, ripple);
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const explorer = '[data-demo-explorer="ready"]';
    const archive = ".archive-viewer";
    const playback = '[data-demo-control="playback"]';
    let focus: Element | null = null;
    let pendingFrame = 0;
    let timeout: number | undefined;
    let finished = false;
    let cursor: { x: number; y: number } | undefined;
    let pointerFrame = 0;

    function wait(delay: number) {
      return new Promise<void>((resolve) => {
        timeout = window.setTimeout(resolve, delay);
      });
    }

    function refreshOverlays() {
      pendingFrame = 0;
      const bounds = focus?.getBoundingClientRect();
      if (finished || !bounds) {
        spotlight.hidden = true;
        return;
      }
      const left = Math.max(0, bounds.left - 6);
      const top = Math.max(0, bounds.top - 6);
      const right = Math.min(innerWidth, bounds.right + 6);
      const bottom = Math.min(innerHeight, bounds.bottom + 6);
      spotlight.hidden = right <= left || bottom <= top;
      if (!spotlight.hidden) {
        Object.assign(spotlight.style, {
          left: `${left}px`,
          top: `${top}px`,
          width: `${right - left}px`,
          height: `${bottom - top}px`,
        });
      }
    }

    function trackViewport() {
      if (!pendingFrame)
        pendingFrame = window.requestAnimationFrame(refreshOverlays);
    }

    function center(target: Element) {
      const bounds = target.getBoundingClientRect();
      return {
        x: bounds.left + bounds.width / 2,
        y: bounds.top + bounds.height / 2,
      };
    }

    function placePointer(point: { x: number; y: number }) {
      cursor = point;
      pointer.hidden =
        point.x < 0 ||
        point.y < 0 ||
        point.x >= innerWidth ||
        point.y >= innerHeight;
      pointer.style.transform = `translate(${point.x}px, ${point.y}px)`;
    }

    async function glide(
      point: { x: number; y: number },
      update?: (fraction: number) => void,
    ) {
      const from = cursor;
      if (!from || reducedMotion.matches) {
        placePointer(point);
        update?.(1);
        return;
      }
      const dx = point.x - from.x;
      const dy = point.y - from.y;
      const distance = Math.hypot(dx, dy);
      if (distance < 2) {
        placePointer(point);
        update?.(1);
        return;
      }

      const duration = Math.min(680, 180 + distance * 0.65);
      const bend = update ? 0 : Math.min(28, distance * 0.1);
      const started = performance.now();
      await new Promise<void>((resolve) => {
        function tick(now: number) {
          const time = Math.min(1, (now - started) / duration);
          const fraction = time * time * (3 - 2 * time);
          const arc = Math.sin(Math.PI * fraction) * bend;
          placePointer({
            x: from!.x + dx * fraction - (dy / distance) * arc,
            y: from!.y + dy * fraction + (dx / distance) * arc,
          });
          update?.(fraction);
          if (time < 1) pointerFrame = requestAnimationFrame(tick);
          else resolve();
        }

        pointerFrame = requestAnimationFrame(tick);
      });
    }

    async function pointAt(target: HTMLElement, region: Element = target) {
      focus = region;
      const menu = target.closest<HTMLElement>(".select-menu");
      if (menu) {
        await wait(50);
        const area = menu.getBoundingClientRect();
        const item = target.getBoundingClientRect();
        if (item.top < area.top || item.bottom > area.bottom) {
          menu.scrollTop +=
            item.top - area.top - (area.height - item.height) / 2;
        }
      } else {
        target.scrollIntoView({
          block: "center",
          behavior: reducedMotion.matches ? "instant" : "smooth",
        });
      }
      trackViewport();
      if (!reducedMotion.matches) {
        let previous = center(target);
        let settled = 0;
        for (let attempt = 0; attempt < 15 && settled < 2; attempt++) {
          await wait(45);
          const next = center(target);
          settled =
            Math.hypot(next.x - previous.x, next.y - previous.y) < 1
              ? settled + 1
              : 0;
          previous = next;
        }
      }
      await glide(center(target));
    }

    async function find<T extends HTMLElement = HTMLElement>(selector: string) {
      const deadline = performance.now() + 6500;
      do {
        const target = document.querySelector<T>(selector);
        if (target?.getClientRects().length) return target;
        await wait(80);
      } while (performance.now() < deadline);
      throw new Error(`Demo control unavailable: ${selector}`);
    }

    async function press(selector: string, region?: string) {
      const target = await find(selector);
      await pointAt(
        target,
        region ? (document.querySelector(region) ?? target) : target,
      );
      const click = center(target);
      placePointer(click);
      if (!pointer.hidden && !reducedMotion.matches) {
        ripple.style.transform = pointer.style.transform;
        for (const [index, wave] of waves.entries()) {
          for (const animation of wave.getAnimations()) animation.cancel();
          wave.animate(
            [
              { opacity: 0.95, scale: 0.25 },
              { opacity: 0, scale: 3.5 },
            ],
            { delay: index * 100, duration: 620, easing: "ease-out" },
          );
        }
        pointer
          .querySelector("span")
          ?.animate(
            [
              { transform: "scale(1)" },
              { transform: "translate(2px, 3px) scale(0.78)", offset: 0.42 },
              { transform: "scale(1)" },
            ],
            { duration: 230, easing: "ease-out" },
          );
      }
      const event = {
        bubbles: true,
        cancelable: true,
        pointerType: "mouse",
        button: 0,
        clientX: click.x,
        clientY: click.y,
      };
      target.dispatchEvent(new PointerEvent("pointerdown", event));
      target.dispatchEvent(new PointerEvent("pointerup", event));
      target.dispatchEvent(new PointerEvent("click", event));
    }

    async function selectOption(trigger: string, value: string) {
      await press(trigger);
      const selector = `[role="option"][data-option-value="${value}"]`;
      const option = await find(selector);
      const label = option.textContent?.trim();
      await press(selector, ".select-menu");
      if (
        !label ||
        !document.querySelector(trigger)?.textContent?.includes(label)
      ) {
        throw new Error(`Demo selection failed: ${value}`);
      }
    }

    function setRange(input: HTMLInputElement, value: number) {
      input.value = String(value);
      input.dispatchEvent(new Event("input", { bubbles: true }));
    }

    async function dragRange(
      input: HTMLInputElement,
      value: number,
      track: Element = input,
    ) {
      const min = Number(input.min);
      const span = Number(input.max) - min;
      const bounds = track.getBoundingClientRect();
      const current = input.valueAsNumber;
      const pointAtValue = (position: number) => ({
        x: bounds.left + bounds.width * ((position - min) / span),
        y: center(input).y,
      });
      await glide(pointAtValue(current));
      await glide(pointAtValue(value), (progress) => {
        setRange(input, current + (value - current) * progress);
      });
      setRange(input, value);
    }

    const actions: Record<string, () => Promise<void>> = {
      async field() {
        await selectOption("#example-field", "nep");
        const image = await find<HTMLImageElement>(
          `${archive} .archive-image img`,
        );
        await image.decode();
        await pointAt(image, image);
      },
      async band() {
        await selectOption("#archive-mode", "1");
      },
      async source() {
        await press(`${archive} .source-marker`, `${archive} .archive-image`);
        const pin = await find(`${archive} .archive-pin`);
        focus = pin;
        pin.scrollIntoView({
          block: "center",
          behavior: reducedMotion.matches ? "instant" : "smooth",
        });
        trackViewport();
      },
      async playback() {
        const speed = await find<HTMLInputElement>(
          `${archive} .playback-speed input`,
        );
        await pointAt(speed);
        await dragRange(speed, 4);
        await press(playback, archive);
        await wait(1200);
        await press(playback, archive);
      },
      async compare() {
        await press('[data-demo-control="swipe"]', archive);
        const divider = await find<HTMLInputElement>("#archive-divider");
        await pointAt(divider, divider.closest(".archive-image") ?? divider);
        await dragRange(
          divider,
          72,
          divider.closest(".archive-image") ?? divider,
        );
      },
      async report() {
        await press(
          `${archive} .archive-detections summary`,
          `${archive} .archive-detections`,
        );
        const exportLink = await find(
          `${archive} .archive-source-actions a[download]`,
        );
        await pointAt(
          exportLink,
          exportLink.closest(".archive-detections") ?? exportLink,
        );
      },
    };

    async function run() {
      for (const step of steps) {
        step.setAttribute("aria-current", "step");
        status.textContent = step.querySelector("span")?.textContent ?? "";
        const result = step.querySelector<HTMLElement>("[data-step-result]")!;
        try {
          await actions[step.dataset.demoStep!]();
          await wait(1900);
          step.setAttribute("data-complete", "");
        } catch {
          step.setAttribute("data-skipped", "");
          result.textContent = "Unavailable";
        }
        result.hidden = false;
        step.removeAttribute("aria-current");
      }
      status.textContent = steps.some((step) =>
        step.hasAttribute("data-skipped"),
      )
        ? "Tour ended with unavailable steps"
        : "Tour complete";
      finished = true;
      pointer.hidden = true;
      refreshOverlays();
    }

    const ready = new MutationObserver(start);
    function start() {
      if (!document.querySelector(explorer)) return;
      ready.disconnect();
      void run();
    }
    ready.observe(document.body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ["data-demo-explorer"],
    });
    window.addEventListener("scroll", trackViewport, {
      passive: true,
      capture: true,
    });
    window.addEventListener("resize", trackViewport, { passive: true });
    start();

    window.addEventListener("pagehide", (event) => {
      if (event.persisted) return;
      ready.disconnect();
      window.clearTimeout(timeout);
      window.cancelAnimationFrame(pendingFrame);
      window.cancelAnimationFrame(pointerFrame);
      window.removeEventListener("scroll", trackViewport, true);
      window.removeEventListener("resize", trackViewport);
    });
  }
</script>

<style>
  .demo-checklist {
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .demo-checklist ol {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .demo-checklist li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.8rem;
    padding-inline: 0.55rem;
    border-radius: var(--luma-radius-inset);
    color: var(--muted-foreground);
    font-size: 0.8125rem;
  }

  .demo-checklist li[aria-current] {
    background: var(--sidebar-accent);
    color: var(--sidebar-accent-foreground);
    font-weight: 650;
  }

  .demo-checklist svg {
    flex: 0 0 0.9rem;
    width: 0.9rem;
    height: 0.9rem;
  }

  .demo-checklist li:not([data-complete]) .step-done,
  .demo-checklist li[data-complete] .step-pending {
    display: none;
  }

  .demo-status {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .demo-ripple {
    position: fixed;
    z-index: 6;
    top: 0;
    left: 0;
    pointer-events: none;
  }

  .demo-ripple span {
    position: absolute;
    inset: -0.6rem auto auto -0.6rem;
    box-sizing: border-box;
    width: 1.2rem;
    height: 1.2rem;
    border: 2px solid white;
    border-radius: 50%;
    box-shadow: 0 0 0 1px oklch(0 0 0 / 70%);
    opacity: 0;
  }

  @media (max-width: 48rem) {
    .demo-checklist {
      padding-top: 0.5rem;
    }

    .demo-checklist ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .demo-checklist li {
      padding-inline: 0.2rem;
      font-size: 0.75rem;
    }
  }

  .demo-spotlight {
    position: fixed;
    z-index: 4;
    pointer-events: none;
    border: 1px solid oklch(1 0 0 / 25%);
    border-radius: var(--luma-radius-surface);
    box-shadow: 0 0 0 200vmax oklch(0 0 0 / 64%);
  }

  .demo-pointer {
    position: fixed;
    z-index: 6;
    top: 0;
    left: 0;
    width: 2.5rem;
    height: 3.125rem;
    pointer-events: none;
    filter: drop-shadow(0 0 1px black) drop-shadow(0 2px 3px black);
  }

  .demo-pointer span,
  .demo-pointer svg {
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: top left;
  }

  .demo-pointer svg {
    translate: -9.375% -6.25%;
  }

  :global(body:has(#demo-tour))
    :global(
      :is(
        .explorer-controls,
        .archive-viewer,
        .archive-pin,
        .archive-detections
      )
    ) {
    scroll-margin-top: 1rem;
  }
</style>
