---
import Check from "@lucide/astro/icons/check";
import Circle from "@lucide/astro/icons/circle";

const chapters = [
  {
    title: "Search the sky",
    focus: ".explorer-controls",
    control: ".explorer-controls button[type=submit]",
    action: "search",
    duration: 5200,
  },
  {
    title: "Inspect a source",
    focus: ".viewer",
    control: ".source-marker",
    action: "sources",
    duration: 3600,
  },
  {
    title: "Compare two exposures",
    focus: ".viewer",
    control: ".viewer-tools button[aria-pressed]:last-child",
    action: "compare",
    duration: 3900,
  },
  {
    title: "Read a pixel spectrum",
    focus: ".viewer",
    control: ".image-controls button[aria-pressed]",
    action: "spectrum",
    result: ".pixel-spectrum",
    duration: 4600,
  },
  {
    title: "Explore a deep field",
    focus: ".archive-viewer",
    control: ".archive-viewer button[aria-label='Next observation']",
    action: "deep",
    duration: 4200,
  },
  {
    title: "Inspect the difference",
    focus: ".difference-preview",
    control: ".difference-preview summary",
    action: "difference",
    duration: 3600,
  },
  {
    title: "Review a track",
    focus: ".astrometry-review",
    control: ".archived-track",
    action: "review",
    result: ".astrometry-results",
    duration: 5200,
  },
];
---

<section
  id="demo-tour"
  class="demo-checklist"
  aria-label="Demo steps"
  data-chapters={JSON.stringify(chapters)}
>
  <ol>
    {chapters.map(({ title }) => (
      <li>
        <Circle class="step-pending" aria-hidden="true" />
        <Check class="step-done" aria-hidden="true" />
        <span>{title}</span>
        <span class="demo-status" data-step-result hidden>
          Completed
        </span>
      </li>
    ))}
  </ol>
  <span class="demo-status" role="status" aria-atomic="true">
    Preparing the demo
  </span>
</section>

<div class="demo-ripple" aria-hidden="true"></div>
<div class="demo-spotlight" aria-hidden="true" hidden></div>
<div class="demo-pointer" aria-hidden="true" hidden>
  <span>
    <svg viewBox="0 0 32 40" aria-hidden="true" focusable="false">
      <path
        d="M3 2.5v30.2l7.6-7.1 5 11.5 5.2-2.3-5-11.3H27L3 2.5Z"
        fill="#090909"
        stroke="#fff"
        stroke-width="2.3"
        stroke-linejoin="round"
      />
    </svg>
  </span>
</div>

<script>
  const tour = document.querySelector<HTMLElement>("#demo-tour");

  if (tour) {
    const steps = [...tour.querySelectorAll<HTMLElement>("li")];
    const status = tour.querySelector<HTMLElement>("[role=status]")!;
    const spotlight = document.querySelector<HTMLElement>(".demo-spotlight")!;
    const pointer = document.querySelector<HTMLElement>(".demo-pointer")!;
    const ripple = document.querySelector<HTMLElement>(".demo-ripple")!;
    document.body.append(spotlight, pointer, ripple);
    const explorer = '[data-demo-explorer="ready"]';
    const review = '[data-demo-review="ready"]';
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const chapters = JSON.parse(tour.dataset.chapters!) as {
      title: string;
      focus: string;
      control: string;
      action: string;
      duration: number;
      result?: string;
    }[];
    let index = 0;
    let finished = false;
    let timeout: number | undefined;
    let focus: Element | null = null;
    let pendingFrame = 0;

    function schedule(delay: number, action: () => void) {
      timeout = window.setTimeout(() => {
        timeout = undefined;
        action();
      }, delay);
    }

    function dispatch(selector: string, action: string) {
      document
        .querySelector(selector)
        ?.dispatchEvent(new CustomEvent("seeyou-demo", { detail: action }));
    }

    function refreshOverlays() {
      pendingFrame = 0;
      if (focus && !finished) {
        const bounds = focus.getBoundingClientRect();
        const left = Math.max(0, bounds.left - 6);
        const top = Math.max(0, bounds.top - 6);
        const right = Math.min(innerWidth, bounds.right + 6);
        const bottom = Math.min(innerHeight, bounds.bottom + 6);
        spotlight.hidden = right <= left || bottom <= top;
        if (!spotlight.hidden) {
          Object.assign(spotlight.style, {
            left: `${left}px`,
            top: `${top}px`,
            width: `${right - left}px`,
            height: `${bottom - top}px`,
          });
        }
      } else {
        spotlight.hidden = true;
      }

      if (finished) pointer.hidden = true;
    }

    function trackViewport() {
      if (!pendingFrame)
        pendingFrame = window.requestAnimationFrame(refreshOverlays);
    }

    function moveTo(selector: string, offset = 0.5) {
      const bounds = document.querySelector(selector)?.getBoundingClientRect();
      if (!bounds) return;
      const x = bounds.left + bounds.width * offset;
      const y = bounds.top + bounds.height / 2;
      pointer.hidden = x < 0 || y < 0 || x >= innerWidth || y >= innerHeight;
      if (!pointer.hidden)
        pointer.style.transform = `translate(${x}px, ${y}px)`;
    }

    function clickControl(control: HTMLElement | null) {
      if (!control) return;
      if (!pointer.hidden && !reducedMotion.matches) {
        ripple.style.transform = pointer.style.transform;
        ripple.animate(
          [
            { opacity: 0.75, scale: 0.35 },
            { opacity: 0, scale: 1.55 },
          ],
          { duration: 430, easing: "ease-out" },
        );
        pointer
          .querySelector("span")
          ?.animate(
            [
              { transform: "scale(1)" },
              { transform: "translate(2px, 3px) scale(0.78)", offset: 0.42 },
              { transform: "scale(1)" },
            ],
            { duration: 230, easing: "ease-out" },
          );
      }
      control.click();
    }

    function setSwipe(value: number) {
      const slider = document.querySelector<HTMLInputElement>("#swipe-divider");
      if (!slider) return;
      slider.value = String(value);
      slider.dispatchEvent(new Event("input", { bubbles: true }));
    }

    function scrollTo(target: Element | null, block: ScrollLogicalPosition) {
      target?.scrollIntoView({
        block,
        behavior: reducedMotion.matches ? "instant" : "smooth",
      });
    }

    function showChapter() {
      const chapter = chapters[index];
      for (const [stepIndex, step] of steps.entries()) {
        const completed =
          stepIndex < index && !step.hasAttribute("data-skipped");
        step.toggleAttribute("data-complete", completed);
        step
          .querySelector("[data-step-result]")
          ?.toggleAttribute(
            "hidden",
            !completed && !step.hasAttribute("data-skipped"),
          );
        if (stepIndex === index) step.setAttribute("aria-current", "step");
        else step.removeAttribute("aria-current");
      }

      if (!chapter) {
        finished = true;
        status.textContent = "Tour complete";
        refreshOverlays();
        return;
      }

      status.textContent = chapter.title;
      dispatch(explorer, chapter.action);
      if (chapter.action === "difference") {
        const details = document.querySelector<HTMLDetailsElement>(
          ".difference-preview details",
        );
        if (details) details.open = false;
      }

      function advance() {
        index += 1;
        showChapter();
      }

      const waitUntil = performance.now() + 7000;
      function demonstrate() {
        const control = document.querySelector<HTMLElement>(chapter.control);
        if (
          chapter.action === "deep" &&
          !control &&
          performance.now() < waitUntil
        ) {
          schedule(120, demonstrate);
          return;
        }
        if (!control) {
          const step = steps[index];
          step?.setAttribute("data-skipped", "");
          const result = step?.querySelector("[data-step-result]");
          if (result) result.textContent = "Unavailable";
          advance();
          return;
        }
        focus = document.querySelector(chapter.focus);
        scrollTo(control ?? focus, "center");
        trackViewport();

        schedule(reducedMotion.matches ? 60 : 460, () => {
          moveTo(chapter.control);
          schedule(reducedMotion.matches ? 60 : 540, () => {
            clickControl(control);
            if (chapter.action === "sources")
              focus = document.querySelector(".sky-window");
            if (chapter.action === "compare")
              focus = document.querySelector(".viewer figure");
            trackViewport();

            if (chapter.action === "compare") {
              const divider = "#swipe-divider";
              setSwipe(50);
              scrollTo(document.querySelector(divider), "nearest");
              schedule(220, () => {
                moveTo(divider);
                schedule(520, () => {
                  moveTo(divider, 0.7);
                  setSwipe(70);
                  schedule(chapter.duration - 740, advance);
                });
              });
            } else if (chapter.result) {
              const selector = chapter.result;
              schedule(900, () => {
                const result = document.querySelector(selector);
                if (result) {
                  focus = result;
                  scrollTo(result, "center");
                  trackViewport();
                }
                schedule(chapter.duration - 900, advance);
              });
            } else {
              schedule(chapter.duration, advance);
            }
          });
        });
      }

      demonstrate();
    }

    const ready = new MutationObserver(start);
    function start() {
      if (!document.querySelector(explorer) || !document.querySelector(review))
        return;
      ready.disconnect();
      showChapter();
    }
    ready.observe(document.body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ["data-demo-explorer", "data-demo-review"],
    });
    window.addEventListener("scroll", trackViewport, {
      passive: true,
      capture: true,
    });
    window.addEventListener("resize", trackViewport, { passive: true });
    start();

    window.addEventListener("pagehide", (event) => {
      if (event.persisted) return;
      ready.disconnect();
      window.clearTimeout(timeout);
      window.cancelAnimationFrame(pendingFrame);
      window.removeEventListener("scroll", trackViewport, true);
      window.removeEventListener("resize", trackViewport);
    });
  }
</script>

<style>
  .demo-checklist {
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .demo-checklist ol {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .demo-checklist li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.8rem;
    padding-inline: 0.55rem;
    border-radius: var(--luma-radius-inset);
    color: var(--muted-foreground);
    font-size: 0.8125rem;
  }

  .demo-checklist li[aria-current] {
    background: var(--sidebar-accent);
    color: var(--sidebar-accent-foreground);
    font-weight: 650;
  }

  .demo-checklist svg {
    flex: 0 0 0.9rem;
    width: 0.9rem;
    height: 0.9rem;
  }

  .demo-checklist li:not([data-complete]) .step-done,
  .demo-checklist li[data-complete] .step-pending {
    display: none;
  }

  .demo-status {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .demo-ripple {
    position: fixed;
    z-index: 6;
    top: -0.6rem;
    left: -0.6rem;
    width: 1.2rem;
    height: 1.2rem;
    border: 2px solid white;
    border-radius: 50%;
    box-shadow: 0 0 0 1px black;
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 48rem) {
    .demo-checklist {
      padding-top: 0.5rem;
    }

    .demo-checklist ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .demo-checklist li {
      padding-inline: 0.2rem;
      font-size: 0.75rem;
    }
  }

  .demo-spotlight {
    position: fixed;
    z-index: 4;
    pointer-events: none;
    border: 1px solid oklch(1 0 0 / 25%);
    border-radius: var(--luma-radius-surface);
    box-shadow: 0 0 0 200vmax oklch(0 0 0 / 64%);
  }

  .demo-pointer {
    position: fixed;
    z-index: 6;
    top: 0;
    left: 0;
    width: 2.5rem;
    height: 3.125rem;
    pointer-events: none;
    filter: drop-shadow(0 0 1px black) drop-shadow(0 2px 3px black);
    transition: transform 0.48s cubic-bezier(0.2, 0.72, 0.3, 1);
  }

  .demo-pointer span,
  .demo-pointer svg {
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: top left;
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-pointer {
      transition: none;
    }
  }

  :global(body:has(#demo-tour))
    :global(
      :is(
        .explorer-controls,
        .viewer,
        .pixel-spectrum,
        .difference-preview,
        .astrometry-review,
        .astrometry-results
      )
    ) {
    scroll-margin-top: 1rem;
  }
</style>
