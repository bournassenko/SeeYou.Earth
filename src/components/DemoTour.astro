---
import ChevronRight from "@lucide/astro/icons/chevron-right";
import Pause from "@lucide/astro/icons/pause";
import Play from "@lucide/astro/icons/play";
import RotateCcw from "@lucide/astro/icons/rotate-ccw";
---

<div id="demo-tour" class="demo-tour" aria-label="Automatic product tour">
  <div role="status" aria-atomic="true">
    <strong data-demo-title>Preparing the demo</strong>
    <span data-demo-description></span>
  </div>
  <div class="demo-controls">
    <progress aria-label="Tour progress" value="0"></progress>
    <button type="button" data-demo-pause disabled>
      <span data-icon-pause>
        <Pause aria-hidden="true" />
      </span>
      <span data-icon-resume hidden>
        <Play aria-hidden="true" />
      </span>
      <span data-icon-replay hidden>
        <RotateCcw aria-hidden="true" />
      </span>
      <span data-pause-label>Pause</span>
    </button>
    <button type="button" data-demo-next disabled>
      Next <ChevronRight aria-hidden="true" />
    </button>
  </div>
</div>

<div class="demo-spotlight" aria-hidden="true" hidden></div>
<div class="demo-pointer" aria-hidden="true" hidden>
  <span>
    <svg viewBox="0 0 32 40" aria-hidden="true" focusable="false">
      <path
        d="M3 2.5v30.2l7.6-7.1 5 11.5 5.2-2.3-5-11.3H27L3 2.5Z"
        fill="#090909"
        stroke="#fff"
        stroke-width="2.3"
        stroke-linejoin="round"
      />
    </svg>
  </span>
</div>

<script>
  const tour = document.querySelector<HTMLElement>("#demo-tour");

  if (tour) {
    const title = tour.querySelector<HTMLElement>("[data-demo-title]")!;
    const description = tour.querySelector<HTMLElement>(
      "[data-demo-description]",
    )!;
    const progress = tour.querySelector<HTMLProgressElement>("progress")!;
    const button = tour.querySelector<HTMLButtonElement>("[data-demo-pause]")!;
    const nextButton =
      tour.querySelector<HTMLButtonElement>("[data-demo-next]")!;
    const spotlight = document.querySelector<HTMLElement>(".demo-spotlight")!;
    const pointer = document.querySelector<HTMLElement>(".demo-pointer")!;
    const explorer = '[data-demo-explorer="ready"]';
    const review = '[data-demo-review="ready"]';
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const chapters = [
      {
        title: "Search the sky",
        description: "Find real SPHEREx observations around M101.",
        focus: ".explorer-controls",
        control: ".explorer-controls button[type=submit]",
        action: "search",
        duration: 5200,
      },
      {
        title: "Inspect a source",
        description:
          "Connect a marker to its measurements and nearby Gaia entries.",
        focus: ".viewer",
        control: ".source-marker",
        action: "sources",
        duration: 3600,
      },
      {
        title: "Compare two exposures",
        description:
          "Move the divider across the aligned images. Dates and wavelengths stay visible.",
        focus: ".viewer",
        control: ".viewer-tools button[aria-pressed]:last-child",
        action: "compare",
        duration: 3900,
      },
      {
        title: "Read a pixel spectrum",
        description:
          "Pin one position to see brightness and uncertainty across wavelengths.",
        focus: ".viewer",
        control: ".image-controls button[aria-pressed]",
        action: "spectrum",
        result: ".pixel-spectrum",
        duration: 4600,
      },
      {
        title: "Inspect the difference",
        description:
          "See both ZTF exposures and the subtraction on the same grid.",
        focus: ".difference-preview",
        control: ".difference-preview summary",
        action: "difference",
        duration: 3600,
      },
      {
        title: "Review a track",
        description:
          "Test an archived trajectory against a withheld observation, then inspect the evidence.",
        focus: ".astrometry-review",
        control: ".archived-track",
        action: "review",
        result: ".astrometry-results",
        duration: 5200,
      },
    ];

    progress.max = chapters.length;
    let index = 0;
    let paused = false;
    let finished = false;
    let timeout: number | undefined;
    let nextAction: (() => void) | undefined;
    let remaining = 0;
    let deadline = 0;
    let focus: Element | null = null;
    let pendingFrame = 0;

    function schedule(delay: number, action: () => void) {
      remaining = delay;
      nextAction = action;
      deadline = performance.now() + delay;
      timeout = window.setTimeout(() => {
        timeout = undefined;
        nextAction = undefined;
        action();
      }, delay);
    }

    function dispatch(selector: string, action: string) {
      document
        .querySelector(selector)
        ?.dispatchEvent(new CustomEvent("seeyou-demo", { detail: action }));
    }

    function refreshOverlays() {
      pendingFrame = 0;
      if (focus && !finished) {
        const bounds = focus.getBoundingClientRect();
        const left = Math.max(0, bounds.left - 6);
        const top = Math.max(0, bounds.top - 6);
        const right = Math.min(innerWidth, bounds.right + 6);
        const bottom = Math.min(innerHeight, bounds.bottom + 6);
        spotlight.hidden = right <= left || bottom <= top;
        if (!spotlight.hidden) {
          Object.assign(spotlight.style, {
            left: `${left}px`,
            top: `${top}px`,
            width: `${right - left}px`,
            height: `${bottom - top}px`,
          });
        }
      } else {
        spotlight.hidden = true;
      }

      if (finished) pointer.hidden = true;
    }

    function trackViewport() {
      if (!pendingFrame)
        pendingFrame = window.requestAnimationFrame(refreshOverlays);
    }

    function moveTo(selector: string, offset = 0.5) {
      const bounds = document.querySelector(selector)?.getBoundingClientRect();
      if (!bounds) return;
      const x = bounds.left + bounds.width * offset;
      const y = bounds.top + bounds.height / 2;
      pointer.hidden = x < 0 || y < 0 || x >= innerWidth || y >= innerHeight;
      if (!pointer.hidden)
        pointer.style.transform = `translate(${x}px, ${y}px)`;
    }

    function labelPlayback(label: "Pause" | "Resume" | "Replay") {
      button.querySelector("[data-pause-label]")!.textContent = label;
      for (const name of ["pause", "resume", "replay"]) {
        button
          .querySelector(`[data-icon-${name}]`)
          ?.toggleAttribute("hidden", name !== label.toLowerCase());
      }
    }

    function clickControl(control: HTMLElement | null) {
      if (!control) return;
      if (!pointer.hidden && !reducedMotion.matches) {
        pointer
          .querySelector("span")
          ?.animate(
            [
              { transform: "scale(1)" },
              { transform: "translate(2px, 3px) scale(0.78)", offset: 0.42 },
              { transform: "scale(1)" },
            ],
            { duration: 230, easing: "ease-out" },
          );
      }
      control.click();
    }

    function setSwipe(value: number) {
      const slider = document.querySelector<HTMLInputElement>("#swipe-divider");
      if (!slider) return;
      slider.value = String(value);
      slider.dispatchEvent(new Event("input", { bubbles: true }));
    }

    function scrollTo(target: Element | null, block: ScrollLogicalPosition) {
      target?.scrollIntoView({
        block,
        behavior: reducedMotion.matches ? "instant" : "smooth",
      });
    }

    function showChapter() {
      const chapter = chapters[index];
      if (!chapter) {
        finished = true;
        title.textContent = "Tour complete";
        description.textContent = "The explorer is ready to use.";
        labelPlayback("Replay");
        nextButton.disabled = true;
        refreshOverlays();
        return;
      }

      title.textContent = chapter.title;
      description.textContent = chapter.description;
      progress.value = index + 1;
      nextButton.disabled = false;
      dispatch(explorer, chapter.action);
      if (chapter.action === "difference") {
        const details = document.querySelector<HTMLDetailsElement>(
          ".difference-preview details",
        );
        if (details) details.open = false;
      }
      focus = document.querySelector(chapter.focus);
      const control = document.querySelector<HTMLElement>(chapter.control);
      scrollTo(control ?? focus, "center");
      trackViewport();

      const advance = () => {
        moveTo("[data-demo-next]");
        schedule(reducedMotion.matches ? 60 : 540, () =>
          clickControl(nextButton),
        );
      };

      schedule(reducedMotion.matches ? 60 : 460, () => {
        moveTo(chapter.control);
        schedule(reducedMotion.matches ? 60 : 540, () => {
          clickControl(control);
          if (chapter.action === "compare") setSwipe(35);
          if (chapter.action === "sources")
            focus = document.querySelector(".sky-window");
          if (chapter.action === "compare")
            focus = document.querySelector(".viewer figure");
          trackViewport();

          if (chapter.action === "compare") {
            schedule(1050, () => {
              scrollTo(document.querySelector("#swipe-divider"), "nearest");
              schedule(350, () => {
                moveTo("#swipe-divider", 0.35);
                schedule(650, () => {
                  moveTo("#swipe-divider", 0.7);
                  setSwipe(70);
                  schedule(chapter.duration - 2050, advance);
                });
              });
            });
          } else if (chapter.result) {
            schedule(900, () => {
              const result = document.querySelector(chapter.result);
              if (result) {
                focus = result;
                scrollTo(result, "center");
                trackViewport();
              }
              schedule(chapter.duration - 900, advance);
            });
          } else {
            schedule(chapter.duration, advance);
          }
        });
      });
    }

    nextButton.addEventListener("click", () => {
      if (paused || finished) return;
      window.clearTimeout(timeout);
      index += 1;
      showChapter();
    });

    button.addEventListener("click", () => {
      if (finished) {
        finished = false;
        index = 0;
        labelPlayback("Pause");
        showChapter();
      } else if (paused) {
        paused = false;
        labelPlayback("Pause");
        nextButton.disabled = false;
        if (nextAction) schedule(remaining, nextAction);
      } else {
        paused = true;
        labelPlayback("Resume");
        nextButton.disabled = true;
        remaining = Math.max(0, deadline - performance.now());
        window.clearTimeout(timeout);
      }
    });

    const ready = new MutationObserver(start);
    function start() {
      if (!document.querySelector(explorer) || !document.querySelector(review))
        return;
      ready.disconnect();
      button.disabled = false;
      showChapter();
    }
    ready.observe(document.body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ["data-demo-explorer", "data-demo-review"],
    });
    window.addEventListener("scroll", trackViewport, {
      passive: true,
      capture: true,
    });
    window.addEventListener("resize", trackViewport, { passive: true });
    start();

    window.addEventListener("pagehide", (event) => {
      if (event.persisted) return;
      ready.disconnect();
      window.clearTimeout(timeout);
      window.cancelAnimationFrame(pendingFrame);
      window.removeEventListener("scroll", trackViewport, true);
      window.removeEventListener("resize", trackViewport);
    });
  }
</script>

<style>
  .demo-tour {
    position: sticky;
    z-index: 5;
    top: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding: 0.75rem 1rem;
    background: var(--popover);
    color: var(--popover-foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 0.35rem 1rem
      color-mix(in oklch, var(--background) 65%, transparent);
  }

  .demo-tour [role="status"] {
    display: grid;
    gap: 0.25rem;
  }

  .demo-tour [data-demo-description] {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .demo-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .demo-controls progress {
    width: 5rem;
    height: 0.55rem;
    accent-color: var(--primary);
  }

  .demo-controls button {
    min-width: 4.5rem;
    min-height: 2.25rem;
    padding: 0.3rem 0.7rem;
    background: var(--secondary);
    color: var(--secondary-foreground);
  }

  .demo-spotlight {
    position: fixed;
    z-index: 4;
    pointer-events: none;
    border: 1px solid oklch(1 0 0 / 25%);
    border-radius: var(--radius);
    box-shadow: 0 0 0 200vmax oklch(0 0 0 / 64%);
  }

  .demo-pointer {
    position: fixed;
    z-index: 6;
    top: 0;
    left: 0;
    width: 2.5rem;
    height: 3.125rem;
    pointer-events: none;
    filter: drop-shadow(0 0 1px black) drop-shadow(0 2px 3px black);
    transition: transform 0.48s cubic-bezier(0.2, 0.72, 0.3, 1);
  }

  .demo-pointer span,
  .demo-pointer svg {
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: top left;
  }

  .demo-controls span[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-pointer {
      transition: none;
    }
  }

  :global(body:has(#demo-tour))
    :global(
      :is(
        .explorer-controls,
        .viewer,
        .pixel-spectrum,
        .difference-preview,
        .astrometry-review,
        .astrometry-results
      )
    ) {
    scroll-margin-top: 7rem;
  }
</style>
