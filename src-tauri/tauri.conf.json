{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SeeYou.Earth",
  "version": "0.1.0",
  "identifier": "earth.seeyou.explorer",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SeeYou.Earth",
        "width": 1100,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/icon.png"]
  }
}
